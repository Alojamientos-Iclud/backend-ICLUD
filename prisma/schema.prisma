// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =================
// Modelos chotos
// =================

model hotel {
  id        Int      @id @default(autoincrement())
  nombre      String
  localizacion  String
  cantidad_habitaciones     Int
  imagen_h String? 
  descripcion String
  precio  Int
  tiene_catering Boolean
  fecha_subido DateTime @default(now())
  fecha_actualizado DateTime @updatedAt
} 
model Formulario {
  id        Int      @id @default(autoincrement())
  nombre_completo     String
  gmail  String
  cantidad_huespedes   Int
  llegada DateTime @db.Date
  salida DateTime @db.Date
  fecha_subido DateTime @default(now())
  fecha_actualizado DateTime @updatedAt
} 

model Usuario {
  id                  Int        @id @default(autoincrement())
  gmail               String
  password            String
  estatus             String
  fecha_subido        DateTime   @default(now())
  fecha_actualizado   DateTime   @updatedAt
  favoritos           Favorito[] 
}

model Favorito {
  id                Int      @id @default(autoincrement())
  idUsuario         Int
  usuario           Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  nombreAlojamiento String
  precio            Float?
  urlOrigen         String
  imagenUrl         String?
  fechaGuardado     DateTime @default(now())

  @@unique([idUsuario, urlOrigen])
}

model OfertaPendiente {
  id                    Int      @id @default(autoincrement())
  nombre                String
  localizacion          String
  cantidad_habitaciones Int      @default(0)
  imagen_h              String?
  descripcion           String   @default("")
  precio                Int      @default(0)
  fecha_subido          DateTime @default(now())
}
